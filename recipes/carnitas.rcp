(recipe
  (meta
    (title "カルニータス(オーブン)")
    (description "Serious Eats「No-Waste Tacos de Carnitas」の肉部分のみ。サルサヴェルデ・トルティーヤ・薬味は省略。")
    (servings "4〜6")
    (locale ja)
    (cuisine "メキシカン")
    (course "メイン")
    (prep-time "15 minutes")
    (cook-time "4 hours")
    (time-required "4h15m")
    (author "J. Kenji López-Alt")
    (source "Serious Eats"))

  (note "裂いて塩で調味したところまで作って冷蔵すれば最大3日保存できる。冷蔵庫から出してそのままブロイラーで焼いてよい。")
  (note "脂をすくったあとに残る煮汁(約120ml)は捨てずにサルサヴェルデのベースにできる。原文ではトマティーヨ・玉ねぎ・にんにく・ハラペーニョと一緒に煮て攪拌する。")
  (note "脂分離器がなければ平たいスプーンで表面の脂をすくう。")
  (note "耐熱ガラス容器は23×33cm(9×13インチ)が目安。豚肉が隙間なく敷き詰まるサイズを選ぶ。")

  (let ((塩をした豚肉 (-> (ing 豚肩ロース 1.35 kg "骨なし。約3ポンド")
                          (op "5cm角に切る" :phase 下準備)
                          (op "塩をふる"
                              (ing コーシャーソルト 8 g "大さじ1。食卓塩なら体積で半量")
                              :phase 下準備)))

        (4等分オレンジ (-> (ing オレンジ 1 個 "中")
                           (op "4等分に切る" :phase 下準備)))

        (くし切り玉ねぎ (-> (ing 玉ねぎ "1/2" 個 "中")
                            (op "くし形に2等分する" :phase 下準備)))

        (半割にんにく (-> (ing にんにく 4 片)
                          (op "半分に切る" :phase 下準備)))

        (折ったシナモン (-> (ing シナモンスティック 1 本)
                            (op "3〜4片に折る" :phase 下準備)))

        ((ザルの中身 空いた容器)
         (-> (tool 耐熱ガラス容器)
             (op "豚肉を隙間なく敷き詰める" 塩をした豚肉 :phase 蒸し煮)
             (op "オレンジを絞って果汁をかけ、絞った皮も肉の間に埋め込む"
                 4等分オレンジ :phase 蒸し煮)
             (op "玉ねぎ・にんにく・ローリエ・シナモンを埋め込み、平らにならす"
                 くし切り玉ねぎ 半割にんにく (ing ローリエ 2 枚) 折ったシナモン
                 :phase 蒸し煮)
             (op "サラダ油を表面に回しかける" (ing サラダ油 60 ml) :phase 蒸し煮)
             (op "アルミホイルでぴったり覆う" :phase 蒸し煮)
             (op "135℃(275°F)に予熱したオーブンの中段で焼く"
                 :heat :on :time (3.5 hour) :attention :none
                 :until "フォークで簡単にほぐれる" :phase 蒸し煮)
             (op "オレンジの皮・玉ねぎ・にんにく・シナモン・ローリエをトングで取り除いて捨てる"
                 :phase 水切り)
             (split "肉・脂・煮汁をザルに移す"
                    (tool ザル) (tool 計量カップ)
                    :note "目の細かいザルを1Lの計量カップかボウルに載せる" :phase 水切り)))

        ((水切りした豚肉 煮汁と脂)
         (-> ザルの中身
             (split "水切りする" :time (10 min) :attention :none :phase 水切り)))

        ((脂 _)
         (-> 煮汁と脂
             (split "表面の脂をすくい取る" :tool 脂分離器
                    :note "煮汁約120ml・脂約120mlになる。煮汁はサルサヴェルデ用に取っておける"
                    :phase 水切り)))

        (調味した豚肉
         (-> 空いた容器
             (op "豚肉を戻す" 水切りした豚肉 :phase 仕上げ)
             (op "すくった脂を加える" 脂 :phase 仕上げ)
             (op "指か2本のフォークで大きめの塊に裂く" :phase 仕上げ)
             (op "味を見て塩で整える" (ing コーシャーソルト) :phase 仕上げ)
             (op "供するまで冷蔵する" :attention :none :phase 仕上げ))))

    (-> 調味した豚肉
        (op "熱源から10cm下の段で、強にしたブロイラーで焼く"
            :heat ブロイラー強 :time (6 min) :attention :partial
            :until "表面が茶色くカリッとする" :phase ブロイル)
        (op "取り出してスプーンで混ぜ、新しい面を出す" :phase ブロイル)
        (op "再びブロイラーで焼く"
            :heat ブロイラー強 :time (6 min) :attention :partial
            :until "カリッとする" :phase ブロイル)
        (op "ホイルをかぶせて保温する" :attention :none :phase ブロイル))))
