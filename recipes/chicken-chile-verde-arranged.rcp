(recipe
  (meta
    (title "チキン・チレ・ベルデ(辛さ強め)")
    (servings "2〜3")
    (locale ja)
    (cuisine "メキシカン")
    (course "メイン")
    (prep-time "15 minutes")
    (cook-time "25 minutes")
    (time-required "40m")
    (author "J. Kenji López-Alt")
    (source "based on Serious Eats"))

  (note "通常のchicken-chile-verdeと比べて辛さと酸味を強くし、合わせてニンニクの香りを強くした。たぶん邪道。")

  (let ((刻んだ万願寺唐辛子 (-> (ing 万願寺唐辛子 225 g "ポブラノの代用")
                          (op "種とヘタを取り除き、ざく切りにする" :phase 下準備)))

        (切ったトマティーヨ (-> (ing トマティーヨ 170 g "約2個")
                                (op "ハスク(外皮)を取り除き、4等分に切る" :phase 下準備)))

        (刻んだ玉ねぎ (-> (ing 白玉ねぎ 140 g "中1/2個")
                          (op "ざく切りにする" :phase 下準備)))

        (刻んだアナハイム (-> (ing アナハイムペッパー 85 g "約1本。ハラペーニョでも可")
                              (op "種とヘタを取り除き、ざく切りにする" :phase 下準備)))

        (刻んだセラーノ (-> (ing セラーノペッパー 3 本 "青唐辛子でも可")
                            (op "ヘタを取り除き、ざく切りにする" :phase 下準備)))

        (剥いたにんにく (-> (ing にんにく 3 片 "中")
                            (op "皮を剥く" :phase 下準備)))

        (挽いたクミン (-> (ing クミンシード "1/2" 大さじ)
                          (op "乾煎りする" :heat :on :tool 小さなフライパン
                              :until "香りが立つ" :phase 下準備)
                          (op "挽く" :phase 下準備)))

        (飾りパクチー (-> (ing パクチー "飾り用")
                          (op "刻む" :phase 下準備)))

        (くし切りライム (-> (ing ライム)
                            (op "くし切りにする" :phase 下準備)))

        (炒めたにんにく
         (-> (tool フライパン)
             (op "にんにくを入れ、30秒ほど香りが立つまで炒める"
                 剥いたにんにく :heat 弱火 :attention :partial
                 :until "香りが立つ" :phase 下準備)))
        
        (ソース鍋
         (-> (tool フライパン)
             (op "野菜・にんにく・クミン・塩を入れる"
                 刻んだ万願寺唐辛子 切ったトマティーヨ 刻んだ玉ねぎ
                 刻んだアナハイム 刻んだセラーノ 挽いたクミン
                 (ing コーシャーソルト "ひとつまみ")
                 :phase ソース)
             (op "強火にかけ、軽くジュージューいうまで熱する"
                 :heat 強火 :attention :partial
                 :until "軽くジュージューと音がする" :phase ソース)
             (op "電気圧力鍋で加圧調理する" (tool 電気圧力鍋)
                 :time (15 min) :attention :none :phase ソース)))

        (裂いた鶏肉
         (-> (ing 鶏肉 675 g "骨なし。胸肉またはもも肉")
             (op "表裏を焼く" :tool フライパン
                 :heat 弱火 :time (30 min) :phase 鶏肉)
             (op "ハンドミキサーで裂く" :tool ハンドミキサー :phase 鶏肉)))

        (完成ソース
         (-> ソース鍋
             (op "パクチーとナンプラーを加える"
                 (ing パクチー "1/4" カップ "葉と細い茎。ふんわり詰めて")
                 (ing ナンプラー 7.5 ml "Red Boatなど")
                 :phase ソース)
             (op "攪拌して滑らかにする" :tool ハンドブレンダー :phase ソース)
             (op "にんにくを加える" 炒めたにんにく :phase ソース)
             (op "リンゴ酢を加える" (ing リンゴ酢 45 cc) :phase ソース)
             (op "味を見て塩で整える" (ing コーシャーソルト) :phase ソース))))

    (-> 完成ソース
        (op "裂いた鶏肉を加え、ソースを絡めて温まったら火を止める"
            裂いた鶏肉 :phase 仕上げ)
        (op "盛り皿に移し、刻んだパクチーを散らす" 飾りパクチー :phase 仕上げ)
        (op "トルティーヤとライムを添えてすぐに供する"
            (ing コーントルティーヤ)
            くし切りライム
            :phase 仕上げ))))
