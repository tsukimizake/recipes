(recipe
  (meta
    (title "チキン・チレ・ベルデ(圧力鍋)")
    (servings "2〜3")
    (locale ja)
    (cuisine "メキシカン")
    (course "メイン")
    (prep-time "15 minutes")
    (cook-time "25 minutes")
    (time-required "40m")
    (author "J. Kenji López-Alt")
    (source "Serious Eats"))

  (note "直火式圧力鍋の場合は野菜を鍋の中で直接予熱し、高圧到達後は圧力を維持できる火力に落とす。")
  (note "ハンドブレンダーがなければ据え置きのミキサーに移して攪拌する。")

  (let ((刻んだ万願寺 (-> (ing 万願寺唐辛子 225 g "ポブラノの代用")
                          (op "種とヘタを取り除き、ざく切りにする" :phase 下準備)))

        (切ったトマティーヨ (-> (ing トマティーヨ 170 g "約2個")
                                (op "ハスク(外皮)を取り除き、4等分に切る" :phase 下準備)))

        (刻んだ玉ねぎ (-> (ing 白玉ねぎ 140 g "中1/2個")
                          (op "ざく切りにする" :phase 下準備)))

        (刻んだアナハイム (-> (ing アナハイムペッパー 85 g "約1本。クバネルでも可")
                              (op "種とヘタを取り除き、ざく切りにする" :phase 下準備)))

        (刻んだセラーノ (-> (ing セラーノペッパー 1 本 "ハラペーニョでも可")
                            (op "ヘタを取り除き、ざく切りにする" :phase 下準備)))

        (剥いたにんにく (-> (ing にんにく 3 片 "中")
                            (op "皮を剥く" :phase 下準備)))

        (挽いたクミン (-> (ing クミンシード "1/2" 大さじ)
                          (op "乾煎りする" :heat :on :tool 小さなフライパン
                              :until "香りが立つ" :phase 下準備)
                          (op "挽く" :phase 下準備)))

        (飾りパクチー (-> (ing パクチー "飾り用")
                          (op "刻む" :phase 下準備)))

        (くし切りライム (-> (ing ライム)
                            (op "くし切りにする" :phase 下準備)))

        (ソース鍋
         (-> (tool フライパン)
             (op "野菜・にんにく・クミン・塩を入れる"
                 刻んだ万願寺 切ったトマティーヨ 刻んだ玉ねぎ
                 刻んだアナハイム 刻んだセラーノ 剥いたにんにく 挽いたクミン
                 (ing コーシャーソルト "ひとつまみ")
                 :phase 予熱)
             (op "強火にかけ、軽くジュージューいうまで熱する"
                 :heat 強火 :attention :partial
                 :until "軽くジュージューと音がする" :phase 予熱)
             (op "電気圧力鍋に移す" (tool 電気圧力鍋) :phase 加圧調理)
             (op "説明書に従い、加圧に必要な水分量を確保する"
                 (ing 水 "必要に応じて") :phase 加圧調理)
             (op "蓋をして密閉する" :phase 加圧調理)
             (op "高圧・15分にセットする" :phase 加圧調理)
             (op "高圧に達するまで待つ"
                 :attention :none :until "高圧に達する" :phase 加圧調理)
             (op "高圧のまま加圧調理する"
                 :time (15 min) :attention :none :phase 加圧調理)
             ;; TODO: 原文は "Release pressure" のみで急速放圧か自然放置か不明。急速放圧として扱っている。
             (op "圧力を抜く" :phase 加圧調理)))

        (焼いた鶏肉
         (-> (ing 鶏肉 675 g "骨なし。胸肉またはもも肉")
             (op "余分な脂や筋を取り、厚い部分を開いて厚みをそろえる" :phase 鶏肉の下準備)
             (op "塩をふる" (ing コーシャーソルト "適量") :phase 鶏肉の下準備)
             (op "野菜を移したフライパンを洗って水気を拭き、油を熱して鶏肉を入れる"
                 (ing 油 "適量") :tool フライパン :heat 中火 :phase 鶏肉の加熱)
             (op "両面を焼き、焼き色がついたら弱火にして中心まで火を通す"
                 :heat 弱火 :until "鶏肉の中心まで完全に火が通る" :phase 鶏肉の加熱)
             (op "皿に取り出して少し休ませ、食べやすい大きさに切る"
                 :phase 鶏肉の加熱)))

        (完成ソース
         (-> ソース鍋
             (op "パクチーとナンプラーを加える"
                 (ing パクチー "1/4" カップ "葉と細い茎。ふんわり詰めて")
                 (ing ナンプラー 7.5 ml "Red Boatなど")
                 :phase ソースの仕上げ)
             (op "攪拌して滑らかにする" :tool ハンドブレンダー :phase ソースの仕上げ)
             (op "水っぽければ好みの濃度まで煮詰める" :heat 中火 :phase ソースの仕上げ)
             (op "味を見て塩で整える" (ing コーシャーソルト) :phase ソースの仕上げ))))

    (-> 完成ソース
        (op "焼いた鶏肉を加え、ソースを絡めて温まったら火を止める"
            焼いた鶏肉 :phase 仕上げ)
        (op "盛り皿に移し、刻んだパクチーを散らす" 飾りパクチー :phase 仕上げ)
        (op "トルティーヤとライムを添えてすぐに供する"
            (ing コーントルティーヤ)
            くし切りライム
            :phase 仕上げ))))
