(recipe
  (meta
    (title "ポーリッシュ法のピザ生地")
    (description "加水率70%。直径28〜30cmのピザ約2枚分")
    (locale ja)
    (course "生地")
    (prep-time "約25分")
    (time-required "約17〜23時間"))

  (note "種は強力粉100g・水100g・インスタントドライイースト1g・はちみつ2g。粉の総量は300g、加水率は70%、塩は粉の2.8%としている。")
  (note "発酵時の室温は20〜22℃を目安にする。発酵時間は生地の状態を優先し、暑い日は短め、寒い日は長めに調整する。")
  (note "焼くときは生地を手で伸ばして具をのせ、十分に予熱したオーブンとピザストーンまたは天板で焼く。焼成時間はオーブンに合わせて調整する。")

  (let ((ポーリッシュ
         (-> (tool ボウル)
             (op "強力粉・水・インスタントドライイースト・はちみつを入れる"
                 (ing 強力粉 100 g)
                 (ing 水 100 g "室温")
                 (ing インスタントドライイースト 1 g)
                 (ing はちみつ 2 g)
                 :phase ポーリッシュ)
             (op "粉気がなくなるまで混ぜる" :phase ポーリッシュ)
             (op "乾燥しないように覆い、室温で発酵させる"
                 :time (2 3 hour) :attention :none :phase ポーリッシュ)
             (op "冷蔵庫で発酵させる"
                 :time (12 16 hour) :attention :none
                 :until "表面に細かな気泡が広がり、ふっくらと膨らんでいる"
                 :phase ポーリッシュ))))

    (-> ポーリッシュ
        (op "ポーリッシュと残りの強力粉・水・塩をパンこね機に入れる"
            (ing 強力粉 200 g)
            (ing 水 110 g "室温")
            (ing 塩 8.4 g)
            :phase 生地作り)
        (op "こねコースで表面がなめらかになるまでこねる"
            :tool パンこね機 :time (10 15 min) :attention :none :phase 生地作り)
        (op "乾燥しないように覆って休ませる"
            :time (10 min) :attention :none :phase 生地作り)
        (op "2等分し、表面を張らせて丸める" :phase 生地作り)
        (op "間隔を空けて容器に入れ、乾燥しないように覆う" :phase 発酵)
        (op "室温で最終発酵させる"
            :time (2 3 hour) :attention :none
            :until "生地玉がふっくらし、指で軽く押した跡がゆっくり戻る"
            :phase 発酵)
        (op "最終発酵後、冷蔵庫で保存する"
            :attention :none :phase 保存))))
