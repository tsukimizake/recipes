; チキン・ティンガ — chicken-tinga.cook からの変換サンプル

(recipe
  (meta
    (title "チキン・ティンガ")
    (description "メキシコ風ピリ辛シュレッドチキン")
    (servings 4)
    (locale ja)
    (cuisine "メキシカン")
    (course "メイン")
    (prep-time "5 minutes")
    (cook-time "60 minutes")
    (time-required "1h5m"))

  (note "鶏ガラスープは低塩タイプ(自家製または市販)を使用。水で代用しても可。")
  (note "鶏胸肉は骨つき・皮つきで2枚、合計約550gが目安。")
  (note "ハンドブレンダーがなければ据え置きのミキサーに移して攪拌する。")

  (let (;; ---- 下準備: 依存のない根ノード群。すべて並列可能 ----
        (玉ねぎ (-> (ing 白玉ねぎ 1 個 "小")
                    (op "みじん切りにする" :phase 下準備)))

        (剥いたトマティーヨ (-> (ing トマティーヨ 170 g "中2個ほど")
                                (op "皮を剥く" :phase 下準備)))

        (剥いたにんにく (-> (ing にんにく 4 片)
                            (op "皮を剥く" :phase 下準備)))

        (下味鶏肉 (op "塩と挽きたての黒胡椒をしっかりめにふる"
                      (ing 鶏胸肉 550 g "骨つき・皮つき")
                      (ing コーシャーソルト)
                      (ing 黒胡椒)
                      :phase 下準備))

        ;; ---- 鶏肉の焼き付け ----
        ((焼けた鶏肉 空いた鍋)
         (-> (tool 中サイズの鍋)
             (op "ラードを入れ、強火で熱する"
                 (ing ラード 30 ml "または植物油")
                 :heat 強火 :until "油が揺らめく" :phase 鶏肉の焼き付け)
             (op "鶏肉を皮目を下にして入れる" 下味鶏肉
                 :heat 強火 :phase 鶏肉の焼き付け)
             (op "動かさずに焼き、しっかりこんがり色をつける"
                 :time (6 8 min) :attention :partial :heat 強火
                 :note "煙が出すぎたり焦げそうなら火を弱める"
                 :phase 鶏肉の焼き付け)
             (op "裏返してさらに焼く"
                 :time (2 min) :attention :partial :heat 強火
                 :phase 鶏肉の焼き付け)
             (split "鶏肉を大きな皿に取り出す"
                    :heat 強火 :phase 鶏肉の焼き付け)))

        ;; ---- 野菜の焼き付け〜煮込み: 鍋は火に載ったまま継続 ----
        ((煮えた鶏肉 ソース鍋)
         (-> 空いた鍋
             (op "すぐにトマティーヨ・トマト・にんにくを入れる"
                 剥いたトマティーヨ
                 (ing 完熟プラムトマト 170 g "中2個ほど")
                 剥いたにんにく
                 :heat 強火 :phase 野菜の焼き付け)
             (op "ときどき返しながら、焼き色とブリスターがつくまで加熱する"
                 :time (5 min) :attention :partial :heat 強火
                 :phase 野菜の焼き付け)
             (op "玉ねぎを加え、しんなりするまで炒める" 玉ねぎ
                 :time (2 min) :attention :full :heat 強火 :phase 煮込み)
             (op "オレガノとローリエを加え、香りが立つまで炒める"
                 (ing 乾燥オレガノ 2 小さじ "できればメキシカンオレガノ")
                 (ing ローリエ 2 枚)
                 :time (30 sec) :attention :full :heat 強火 :phase 煮込み)
             (op "リンゴ酢と鶏ガラスープを注ぐ"
                 (ing リンゴ酢 30 ml)
                 (ing 鶏ガラスープ 475 ml)
                 :heat 強火 :phase 煮込み)
             (op "鶏肉を戻し、強火で沸騰させる" 焼けた鶏肉
                 :heat 強火 :phase 煮込み)
             (op "ごく弱火に落とし、蓋をする" :heat ごく弱火 :phase 煮込み)
             (op "ときどき鶏肉を返しながら煮る"
                 :time (20 30 min) :attention :partial :heat ごく弱火
                 :until "肉の一番厚い部分の中心温度が63℃" :phase 煮込み)
             (split "鶏肉をボウルに取り出す" :heat ごく弱火 :phase 煮込み)))

        ;; ---- 鶏肉の処理: ソースの仕上げと並列可能なブランチ ----
        (裂いた鶏肉
         (-> 煮えた鶏肉
             (op "触れる温度まで冷ます" :attention :none :phase 鶏肉の処理)
             (op "皮と骨を取り除いて捨てる" :phase 鶏肉の処理)
             (op "肉を細かく裂く" :phase 鶏肉の処理)))

        ;; ---- ソースの仕上げ ----
        (完成ソース
         (-> ソース鍋
             (op "混ぜながら、ソースが元の量の半分ほどになるまで煮詰める"
                 :time (5 min) :attention :full :heat 強め
                 :phase ソースの仕上げ)
             (op "チポトレとアドボソースを加える"
                 (ing チポトレチリのアドボソース漬け 3 本 "缶詰")
                 (ing アドボソース 15 ml "缶の漬け汁")
                 :heat 強め :phase ソースの仕上げ)
             (op "ローリエを取り除いて捨てる" :heat 強め :phase ソースの仕上げ)
             ;; TODO: 原文では攪拌時に火にかけたままか不明。ここでは火から
             ;; 下ろした扱いにしている(:heat なし)。要確認。
             (op "ソースを攪拌し、小さな塊が少し残る程度のほぼ滑らかな状態にする"
                 :tool ハンドブレンダー :phase ソースの仕上げ))))

    ;; ---- 仕上げ: 2ブランチの合流。最終式 = 完成品 ----
    (-> 完成ソース
        (op "裂いた肉をソースに戻し、ナンプラーを加えて混ぜ合わせる"
            裂いた鶏肉
            (ing ナンプラー 10 ml)
            :phase 仕上げ)
        (op "再び火にかけ、混ぜながらソースが鶏肉によくからむ濃度になるまで煮る"
            :heat :on :attention :full
            :until "汁気は十分残っているがスープ状ではない"
            :phase 仕上げ)
        (op "味を見て、必要なら塩胡椒で整える" :phase 仕上げ))))
